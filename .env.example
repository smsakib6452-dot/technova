# ------------------------------------------------------------------
# TECHNOVA environment variables (EXAMPLE)
# Copy this to `.env.local` and fill values for local development.
# Never commit real secrets.
# ------------------------------------------------------------------

# Optional: Pexels API key for auto image search (site works without it).
# PEXELS_API_KEY=your_pexels_api_key_here

# PostgreSQL connection string used by Prisma (future phases).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/technova

# Next.js auth secret (future phase). Generate with: openssl rand -base64 32
# AUTH_SECRET=

# Demo mode forces the mock data layer even when a database is present.
NEXT_PUBLIC_DEMO_MODE=true

# Admin login: set to the SHA-256 hex of your chosen admin password.
# Generate locally with: node -e "console.log(require('crypto').createHash('sha256').update('your-password').digest('hex'))"
NEXT_PUBLIC_ADMIN_HASH=your_hex_sha256_hash_here
